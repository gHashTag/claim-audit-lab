#!/usr/bin/env python3
"""tri — единая командная строка тика непрерывного аудита.

Зачем. Каждый тик повторял одни и те же длинные строки: фоновый запуск с
опросом, путь к ведомости, путь к счётчикам, сборка скила. Повторение руками —
источник расхождений (в тике 41 из-за него дважды терялся `bump`). Здесь
детерминированная часть работы делается кодом, а не памятью.

Команды (`tri <команда> --help` для подробностей):

  быстрые проверки
    tri gate            гейт слияния (ci_gate.sh) целиком
    tri quick           короткий круг: самопроверка + корпус + мутации
    tri proof           execution-proof на реальном маршруте CLI
    tri mut             мутационная проверка детектора
    tri indep           независимость разметки от детектора
    tri manifest        сверка coverage manifest с фактом

  длинные шаги (в фоне, с опросом)
    tri regress         перепрогон реестра
    tri run <кейс>      прогон одного кейса
    tri cover           выбор цели по корпусу
    tri watch           показать, что сейчас работает в фоне

  состояние и опыт
    tri status          сводка: счётчики, отпечатки, состав корпуса, границы
    tri note <текст>    записать опыт в ведомость (с отметкой времени и тика)
    tri exp [N]         последние N записей опыта
    tri tick start|done|abort [причина]

  наблюдаемость и воспроизводимость
    tri runs [N]        последние вызовы: run_id, статус, код, артефакты
    tri log verify      проверка хеш-цепочки журнала (машинный JSON)
    tri verify          перепроверка снимка по SHA-256 без сети
    tri archive         контракт архива скила (записи, порядок, детерминизм)
    tri bench [N]       измерение времени команд: median, p95, min/max

  сопровождение
    tri snapshot        снимок baseline и проверяемый манифест SHA-256
    tri skill           сборка и проверка пакета скила
    tri selftest        самопроверка самой tri

Каждый вызов оставляет событие в журнале вызовов (run_id, тик, коммит
корпуса, отпечаток baseline, PID, код возврата, артефакты). Длительные
исключительные команды берут замок: два одновременных тика запрещены.

Код возврата ненулевой при провале — tri можно ставить в CI.
"""
from __future__ import annotations

import json
import os
import re
import shlex
import subprocess
import sys
import tempfile
import time

ROOT = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, ROOT)
from goldsieve import chain, runlog  # noqa: E402

TRACK = "/home/user/workspace/cron_tracking/8dff7aa3"
# Переопределения через среду нужны интеграционным тестам: они гоняют
# НАСТОЯЩУЮ tri как подпроцесс, но на временной ведомости и счётчиках.
LEDGER = os.environ.get("TRI_LEDGER", os.path.join(TRACK, "audit-ledger.md"))
COUNTERS = os.environ.get("GOLDSIEVE_COUNTERS",
                          os.path.join(TRACK, "tick-counters.json"))
LOCK = os.environ.get("TRI_LOCK", "/tmp/tri-tick.lock")
CORPUS = "/home/user/workspace/corpus/trinity"
SKILL_SRC = "/home/user/workspace/skills/user/goldsieve"
SKILL_BUILD = "/home/user/workspace/skills-build"

# Метка опыта в ведомости. По ней `tri exp` находит записи, поэтому она
# фиксирована и не переписывается в каждом тике.
EXP_MARK = "ОПЫТ:"


def _run(args: list[str], timeout: int = 3600) -> int:
    # Вывод подпроцесса идёт прямо в дескриптор, а свой — через буфер, поэтому
    # без сброса порядок строк перемешивается (найдено при первом же `tri
    # status`: заголовки печатались ПОСЛЕ вывода дочерних команд).
    print("$ " + " ".join(shlex.quote(a) for a in args), flush=True)
    return subprocess.call(args, cwd=ROOT, timeout=timeout)


def _bg(args: list[str], log: str) -> int:
    """Фоновый запуск с опросом. Ловушка `cd X && A & B` обойдена: команда
    целиком уходит в bash -c, а не склеивается оператором фона."""
    cmd = "cd %s && %s" % (shlex.quote(ROOT),
                           " ".join(shlex.quote(a) for a in args))
    subprocess.Popen(["setsid", "nohup", "bash", "-c",
                      "%s > %s 2>&1" % (cmd, shlex.quote(log))],
                     start_new_session=True)
    print("фон запущен, журнал: %s" % log)
    print("опрос: tail -f %s   |   что работает: tri watch" % log)
    return 0


def _counters() -> dict:
    """Счётчики лежат ВЛОЖЕННО под ключом `counters` рядом с журналом
    событий. Первая версия читала верхний уровень и молча давала ноль —
    тихий отказ, пойманный первым же запуском `tri status`."""
    try:
        with open(COUNTERS, encoding="utf-8") as fh:
            data = json.load(fh)
    except Exception:
        return {}
    inner = data.get("counters")
    return inner if isinstance(inner, dict) else {
        k: v for k, v in data.items() if isinstance(v, int)}


def _tick_no() -> int:
    """Номер тика = число начатых тиков по счётчикам (0 при отсутствии)."""
    return int(_counters().get("tick_started", 0))


def cmd_gate(argv: list[str]) -> int:
    return _run(["bash", os.path.join(ROOT, "ci_gate.sh")])


def cmd_quick(argv: list[str]) -> int:
    fail = 0
    for step in (["python3", "-m", "goldsieve.selftest"],
                 ["python3", "measure_identity.py"],
                 ["python3", "mutation_identity.py"],
                 ["python3", "independence.py"]):
        rc = _run(step)
        print("  -> код %d" % rc)
        fail |= 1 if rc else 0
    return fail


def cmd_proof(argv: list[str]) -> int:
    return _run(["python3", "execution_proof.py"])


def cmd_mut(argv: list[str]) -> int:
    return _run(["python3", "mutation_identity.py"])


def cmd_indep(argv: list[str]) -> int:
    return _run(["python3", "independence.py"])


def cmd_manifest(argv: list[str]) -> int:
    return _run(["python3", "coverage_manifest.py"])


def cmd_regress(argv: list[str]) -> int:
    # Реестр уже содержит отпечаток каждого рецепта и локального наблюдаемого
    # входа. Полный прогон 164 кейсов стал источником срывов по времени, тогда
    # как для тика достаточно выбрать только изменившиеся записи. Полный
    # регресс по-прежнему доступен напрямую через `goldsieve regress`, но
    # оболочка тика обязана пользоваться дешёвым инкрементальным режимом.
    return _bg(["timeout", "300", "python3", "-m", "goldsieve", "regress",
                "--changed-only", "--registry", "claims.yaml"],
               "/tmp/tri-regress.txt")


def cmd_run(argv: list[str]) -> int:
    if not argv:
        print("нужен путь к кейсу: tri run cases/имя.py")
        return 2
    log = "/tmp/tri-run-%s.txt" % os.path.basename(argv[0]).replace(".py", "")
    return _bg(["timeout", "1800", "python3", "-m", "goldsieve", "run"]
               + argv, log)


def cmd_cover(argv: list[str]) -> int:
    return _bg(["timeout", "900", "python3", "-m", "goldsieve", "cover",
                CORPUS, "--registry", "claims.yaml"], "/tmp/tri-cover.txt")


def cmd_watch(argv: list[str]) -> int:
    out = subprocess.run(["ps", "ax"], capture_output=True, text=True).stdout
    rows = [l for l in out.splitlines()
            if re.search(r"ci_gate|goldsieve (regress|run|cover)"
                         r"|mutation_identity|execution_proof", l)
            and "grep" not in l]
    if not rows:
        print("в фоне ничего из инструментов не работает")
        return 0
    print("работает в фоне: %d" % len(rows))
    for r in rows:
        print("  " + r.strip()[:150])
    return 0


def cmd_status(argv: list[str]) -> int:
    print("=== тик: %d" % _tick_no(), flush=True)
    cnt = _counters()
    if not cnt:
        print("  счётчики недоступны: %s" % COUNTERS, flush=True)
    for k, v in sorted(cnt.items()):
        print("  %-26s %s" % (k, v), flush=True)
    print("=== корпус", flush=True)
    head = subprocess.run(["git", "-C", CORPUS, "rev-parse", "--short", "HEAD"],
                          capture_output=True, text=True).stdout.strip()
    print("  HEAD %s" % (head or "неизвестен"), flush=True)
    print("=== состав корпуса фикстур и границы", flush=True)
    rc = _run(["python3", "-c",
               "import sys; sys.path.insert(0,'.');"
               "from goldsieve import identity_corpus as C;"
               "print('  положительных', len(C.POSITIVE),"
               " 'негативных', len(C.NEGATIVE));"
               "print('  правило трёх: 3/%d = %.4f'"
               " % (len(C.NEGATIVE), 3/len(C.NEGATIVE)))"])
    print("=== baseline", flush=True)
    _run(["python3", "baseline.py", "check"])
    return rc


def cmd_note(argv: list[str]) -> int:
    """Записать опыт в ведомость. Опыт, не записанный сразу, теряется к концу
    тика — поэтому команда одна строка, а не процедура."""
    text = " ".join(argv).strip()
    if not text:
        print("нужен текст: tri note 'что выяснилось и чем доказано'")
        return 2
    line = "- %s тик %d, %s — %s\n" % (
        EXP_MARK, _tick_no(), time.strftime("%Y-%m-%d %H:%M"), text)
    with open(LEDGER, "a", encoding="utf-8") as fh:
        fh.write(line)
    print("записано в ведомость: %s" % LEDGER)
    print(line.rstrip())
    return 0


def cmd_exp(argv: list[str]) -> int:
    n = int(argv[0]) if argv and argv[0].isdigit() else 10
    try:
        rows = [l.rstrip() for l in open(LEDGER, encoding="utf-8")
                if EXP_MARK in l]
    except OSError as exc:
        print("ведомость недоступна: %s" % exc)
        return 1
    print("записей опыта: %d, показаны последние %d" % (len(rows), min(n, len(rows))))
    for r in rows[-n:]:
        print("  " + r)
    return 0


def cmd_tick(argv: list[str]) -> int:
    if not argv:
        print("нужно: tri tick start|done|abort [причина]")
        return 2
    what = argv[0]
    key = {"start": "tick_started", "done": "tick_completed",
           "abort": "tick_aborted_other"}.get(what)
    if key is None:
        print("неизвестно: %s" % what)
        return 2
    return _run(["python3", "tick_counters.py", "bump", key])


def cmd_snapshot(argv: list[str]) -> int:
    rc = _run(["python3", "baseline.py", "snapshot"])
    if rc:
        return rc
    # Снимок baseline покрывает только файлы инструмента; проверяемый
    # манифест добавляет отчёты, ведомость и журналы прогонов.
    rc = _run(["python3", "snapshot_manifest.py", "build"])
    if rc:
        return rc
    # Checkpoint журнала (тик 44): снимок обязан связать свой SHA-256 с
    # головой журнала, иначе журнал можно начать заново без следа.
    return _run(["python3", "snapshot_manifest.py", "checkpoint"])


def cmd_verify(argv: list[str]) -> int:
    return _run(["python3", "snapshot_manifest.py", "verify"])


def cmd_archive(argv: list[str]) -> int:
    """Контракт архива: две сборки из одного состояния обязаны совпасть по
    SHA-256, записей не больше ста, каталогов и повторов нет."""
    src = argv[0] if argv else os.path.join(SKILL_BUILD, "goldsieve")
    return _run(["python3", "archive_contract.py", "build", src,
                 os.path.join(SKILL_BUILD, "goldsieve.zip")])


def cmd_runs(argv: list[str]) -> int:
    n = int(argv[0]) if argv and argv[0].isdigit() else 15
    rows, broken = runlog.runs()
    if broken:
        print("битых строк в журнале: %d (обрыв записи при падении)"
              % broken, flush=True)
    print("вызовов всего: %d, показаны последние %d"
          % (len(rows), min(n, len(rows))), flush=True)
    for r in rows[-n:]:
        mark = " (выведено)" if r.get("derived") else ""
        print("  %-8s %-9sтик %-4s %-22s код %-5s %s%s" % (
            r["run_id"][-8:], r.get("status", "?"), r.get("tick"),
            r.get("command"), r.get("exit_code", "-"),
            ",".join(r.get("artifacts", [])) or "-", mark), flush=True)
    return 0


def cmd_log(argv: list[str]) -> int:
    """`tri log verify [путь]` — проверка хеш-цепочки журнала.

    Печатает машинный JSON и возвращает ненулевой код при любом нарушении:
    команда годится в гейт, а не только для глаз.

    Ограничение, которое печатается ВМЕСТЕ с результатом: цепочка обнаруживает
    правку проверяемой копии, но не доказывает авторства и не защищает от
    полной подмены журнала вместе с checkpoint.
    """
    if not argv or argv[0] != "verify":
        print("использование: tri log verify [путь-к-журналу]", flush=True)
        return 2
    path = argv[1] if len(argv) > 1 else runlog.runs_path()
    cp = runlog.read_checkpoint()
    rep = chain.verify(path, checkpoint=cp)
    print(json.dumps(rep, ensure_ascii=False, indent=2, sort_keys=True),
          flush=True)
    return 0 if rep["ok"] else 1


