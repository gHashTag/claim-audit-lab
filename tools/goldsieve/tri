    n = argv[0] if argv and argv[0].isdigit() else "20"
    return _run(["python3", "bench.py", "--repeats", n])


def cmd__sleep(argv: list[str]) -> int:
    """Служебная команда для интеграционных тестов: держать замок N секунд."""
    time.sleep(float(argv[0]) if argv else 1.0)
    return 0


def cmd__crash(argv: list[str]) -> int:
    """Служебная команда для интеграционных тестов: аварийное падение."""
    raise RuntimeError("проверочное падение")


def cmd_skill(argv: list[str]) -> int:
    """Сборка пакета скила: синхронизация, валидация, zip. Ловушка ≤100 файлов
    проверяется здесь же, чтобы не узнавать об этом от сервиса."""
    os.makedirs(SKILL_BUILD, exist_ok=True)
    rc = _run(["rsync", "-a", "--delete",
               "--exclude", "*.json", "--exclude", "*.txt",
               "--exclude", "__pycache__",
               SKILL_SRC + "/", os.path.join(SKILL_BUILD, "goldsieve") + "/"])
    if rc:
        return rc
    pkg = os.path.join(SKILL_BUILD, "goldsieve")
    files = sum(len(f) for _r, _d, f in os.walk(pkg))
    print("файлов в пакете: %d (предел 100)" % files)
    if files > 100:
        print("ПРОВАЛ: пакет превышает предел, лишнее не кладётся в скил")
        return 1
    rc = _run(["agentskills", "validate", pkg])
    if rc:
        return rc
    zip_path = os.path.join(SKILL_BUILD, "goldsieve.zip")
    if os.path.exists(zip_path):
        os.remove(zip_path)
    # Ключ -D обязателен: без него zip кладёт ещё и записи КАТАЛОГОВ, а предел
    # в 100 считается по записям архива. 96 файлов + 9 каталогов = 105, и
    # сохранение скила отвергается с сообщением про «too many files».
    return _run(["bash", "-c", "cd %s && zip -qrD goldsieve.zip goldsieve"
                 % shlex.quote(SKILL_BUILD)])


def selftest() -> tuple[int, int]:
    ok = fail = 0

    def check(name: str, cond: bool, note: str = "") -> None:
        nonlocal ok, fail
        if cond:
            ok += 1
            print("  ок      %s" % name)
        else:
            fail += 1
            print("  ПРОВАЛ  %s %s" % (name, note))

    check("каждая команда имеет обработчик",
          all(callable(v) for v in COMMANDS.values()))
    check("справка перечисляет все команды",
          all(("tri " + k) in __doc__ for k in COMMANDS))
    check("справка не разглашает служебные команды",
          all(("tri " + k) not in __doc__ for k in HIDDEN))
    # Запись опыта: проверяется на ВРЕМЕННОЙ ведомости, а не на настоящей.
    global LEDGER
    real = LEDGER
    with tempfile.TemporaryDirectory() as tmp:
        LEDGER = os.path.join(tmp, "ledger.md")
        open(LEDGER, "w", encoding="utf-8").write("# заголовок\n")
        rc = cmd_note(["проверка", "записи"])
        body = open(LEDGER, encoding="utf-8").read()
        check("опыт дописывается строкой с меткой",
              rc == 0 and EXP_MARK in body and "проверка записи" in body)
        check("пустой опыт не пишется",
              cmd_note([]) == 2)
        check("чтение опыта находит запись", cmd_exp(["5"]) == 0)
        # ПОДСТАВКА: заголовок ведомости не должен считаться опытом.
        rows = [l for l in open(LEDGER, encoding="utf-8") if EXP_MARK in l]
        check("метка не ловит посторонние строки", len(rows) == 1)
    LEDGER = real
    check("номер тика читается числом", isinstance(_tick_no(), int))
    # Счётчики: вложенная раскладка и плоская — обе читаются, а журнал
    # событий не попадает в счётчики. ПОДСТАВКА: чтение верхнего уровня
    # вместо вложенного даёт ноль и провалит эту проверку.
    global COUNTERS
    real_c = COUNTERS
    with tempfile.TemporaryDirectory() as tmp:
        COUNTERS = os.path.join(tmp, "c.json")
        json.dump({"counters": {"tick_started": 7}, "events": [1, 2, 3]},
                  open(COUNTERS, "w", encoding="utf-8"))
        check("вложенные счётчики читаются", _tick_no() == 7)
        check("журнал событий не попадает в счётчики",
              "events" not in _counters())
        json.dump({"tick_started": 5}, open(COUNTERS, "w", encoding="utf-8"))
        check("плоская раскладка тоже читается", _tick_no() == 5)
        COUNTERS = os.path.join(tmp, "нет.json")
        check("отсутствие файла даёт пустоту, а не исключение",
              _counters() == {})
    COUNTERS = real_c
    check("неизвестная команда даёт код 2", main(["нетакой"]) == 2)
    # Новое в тике 43: журнал вызовов, замок, служебные команды.
    check("служебные команды не в рабочем списке",
          all(k.startswith("_") for k in HIDDEN)
          and not set(HIDDEN) & set(COMMANDS))
    check("замок берётся только известными командами",
          LOCKED <= (set(COMMANDS) | set(HIDDEN)))
    with tempfile.TemporaryDirectory() as tmp:
        old = os.environ.get("GOLDSIEVE_RUNS")
        os.environ["GOLDSIEVE_RUNS"] = os.path.join(tmp, "runs.jsonl")
        rc = main(["watch"])
        rows, broken = runlog.runs()
        check("вызов попадает в журнал со статусом и кодом",
              rc == 0 and len(rows) == 1 and rows[0]["status"] == "passed"
              and rows[0]["command"] == "watch" and broken == 0)
        try:
            main(["_crash"])
            check("падение попадает в журнал как failed", False, "без исключения")
        except RuntimeError:
            rows, _ = runlog.runs()
            crashed = [r for r in rows if r["command"] == "_crash"]
            check("падение попадает в журнал как failed",
                  len(crashed) == 1 and crashed[0]["status"] == "failed")
        if old is None:
            os.environ.pop("GOLDSIEVE_RUNS", None)
        else:
            os.environ["GOLDSIEVE_RUNS"] = old
    print("tri: %d пройдено, %d провалено" % (ok, fail))
    return ok, fail


def cmd_selftest(argv: list[str]) -> int:
    return 1 if selftest()[1] else 0


COMMANDS = {
    "gate": cmd_gate, "quick": cmd_quick, "proof": cmd_proof, "mut": cmd_mut,
    "indep": cmd_indep, "manifest": cmd_manifest, "regress": cmd_regress,
    "run": cmd_run, "cover": cmd_cover, "watch": cmd_watch,
    "status": cmd_status, "note": cmd_note, "exp": cmd_exp, "tick": cmd_tick,
    "snapshot": cmd_snapshot, "skill": cmd_skill, "selftest": cmd_selftest,
    "runs": cmd_runs, "verify": cmd_verify, "archive": cmd_archive,
    "bench": cmd_bench, "log": cmd_log,
}

# Служебные команды для интеграционных тестов. В справке их нет, и в
# самопроверке требование «справка перечисляет все команды» на них не
# распространяется: они не часть рабочего интерфейса тика.
HIDDEN = {"_sleep": cmd__sleep, "_crash": cmd__crash}

# Команды, которые меняют общее состояние (baseline, пакет скила) или
# долго держат процессор. Два таких вызова одновременно — ошибка, а не
# ожидание: иначе два тика пишут в один baseline и одну ведомость.
LOCKED = {"gate", "quick", "snapshot", "skill", "archive", "bench", "_sleep"}


def main(argv: list[str]) -> int:
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__)
        return 0
    name = argv[0]
    fn = COMMANDS.get(name) or HIDDEN.get(name)
    if fn is None:
        print("неизвестная команда: %s\nсписок: tri --help" % name)
        return 2
    run = runlog.start(name, argv[1:], tick=_tick_no())
    lock = None
    try:
        if name in LOCKED:
            try:
                lock = runlog.Lock(LOCK).acquire()
            except runlog.LockBusy as exc:
                print("ЗАМОК ЗАНЯТ: %s. Одновременные тики запрещены." % exc,
                      flush=True)
                runlog.finish(run, 3, status="aborted")
                return 3
        rc = fn(argv[1:])
    except BaseException as exc:
        # Падение ОБЯЗАНО попасть в журнал: вызов без финального события
        # выглядит как работающая задача и молча искажает картину здоровья.
        runlog.finish(run, 70, status="failed",
                      artifacts=["исключение: %s" % type(exc).__name__])
        raise
    finally:
        if lock is not None:
            lock.release()
    runlog.finish(run, rc, artifacts=_artifacts(name, argv[1:]))
    return rc


def _artifacts(name: str, argv: list[str]) -> list[str]:
    """Артефакты вызова: то, на что потом сошлётся отчёт."""
    if name == "regress":
        return ["/tmp/tri-regress.txt"]
    if name == "cover":
        return ["/tmp/tri-cover.txt"]
    if name == "run" and argv:
        return ["/tmp/tri-run-%s.txt"
                % os.path.basename(argv[0]).replace(".py", "")]
    if name in ("skill", "archive"):
        return [os.path.join(SKILL_BUILD, "goldsieve.zip")]
    if name == "snapshot":
        return [os.path.join(ROOT, "baseline", "manifest.json"),
                os.path.join(ROOT, "baseline", "snapshot-manifest.json")]
    return []


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
